  { "name": "node entry URL with a query", "entries": [{ "exe": "/usr/bin/node", "argv": ["node", "./stage.mjs?version=SENTINEL.mjs"] }], "want": { "program": "node" } },
  { "name": "punctuated script stops the walk", "entries": [{ "exe": "/usr/bin/node", "argv": ["node", "./phase#5.mjs"] }, { "exe": "/bin/bash", "argv": ["bash", "./run.sh"] }], "want": { "program": "node" } },
  { "name": "shell -c is not a script", "entries": [{ "exe": "/bin/bash", "argv": ["bash", "-c", "echo SENTINEL.sh"] }], "want": { "program": "bash" } },
  { "name": "framework python", "entries": [{ "exe": "/Library/Frameworks/Python.framework/Versions/3.12/Resources/Python.app/Contents/MacOS/Python", "argv": ["python3", "tests/run.py", "SENTINEL_ARG"] }], "want": { "program": "Python", "script": "tests/run.py" } },
  { "name": "versioned python", "entries": [{ "exe": "/usr/bin/python3.12", "argv": ["python3", "-m", "pytest"] }], "want": { "program": "python3.12" } },
