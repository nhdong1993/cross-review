  { "name": "first of two scripts, deepest first: a", "entries": [{ "exe": "/usr/bin/node", "argv": ["node", "a.mjs"] }, { "exe": "/usr/bin/node", "argv": ["node", "b.mjs"] }, { "exe": "/bin/bash", "argv": ["bash"] }], "want": { "program": "node", "script": "a.mjs" } },
