  { "name": "option before the script", "entries": [{ "exe": "/usr/bin/node", "argv": ["node", "--require=./SENTINEL.cjs", "./stage.mjs"] }], "want": { "program": "node" } },
  { "name": "changed process title", "entries": [{ "exe": "/usr/bin/node", "argv": ["SENTINEL.js", "--title=SENTINEL.js"] }], "want": { "program": "node" } },
  { "name": "bun package task", "entries": [{ "exe": "/opt/bun/bin/bun", "argv": ["bun", "SENTINEL.js"] }], "want": { "program": "bun" } },
