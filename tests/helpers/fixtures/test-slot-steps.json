[
  { "name": "nested script under a shell", "entries": [{ "exe": "/bin/sleep", "argv": ["sleep", "5"] }, { "exe": "/usr/local/bin/node", "argv": ["node", "./stage.mjs", "--flag", "SENTINEL_ARG"] }, { "exe": "/bin/bash", "argv": ["bash", "-c", "node ./stage.mjs SENTINEL_ARG"] }], "want": { "program": "node", "script": "./stage.mjs" } },
  { "name": "native payload alone", "entries": [{ "exe": "/bin/sleep", "argv": ["sleep", "SENTINEL_ARG"] }], "want": { "program": "sleep" } },
